# ==============================================================
# ClinicOS Voice — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================

# ── Application ────────────────────────────────────────────
APP_NAME="ClinicOS Voice"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development   # development | staging | production

# ── Database ───────────────────────────────────────────────
# Async URL for SQLAlchemy (used at runtime)
# Local Docker: postgresql+asyncpg://clinicos:secret@localhost:5433/clinicos_voice
# Neon/Production: postgresql+asyncpg://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://clinicos:secret@localhost:5433/clinicos_voice

# Sync URL for Alembic migrations (replace asyncpg with psycopg2)
DATABASE_URL_SYNC=postgresql+psycopg2://clinicos:secret@localhost:5433/clinicos_voice

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false   # Set to true to enable slot-hold locking via Redis

# ── LiveKit ────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Groq ───────────────────────────────────────────────────
# FREE tier: console.groq.com → API Keys → Create key
# Free quota: 30 requests/min, 14,400 req/day (more than enough for dev/testing)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Deepgram (Speech-to-Text) ───────────────────────────────
# FREE tier: console.deepgram.com → $200 free credit (no expiry, no card)
# Used for: real-time transcription of patient phone calls
DEEPGRAM_API_KEY=your_deepgram_api_key

# ── ElevenLabs (Text-to-Speech) ────────────────────────────
# FREE tier: elevenlabs.io → 10,000 characters/month free
# Used for: the AI receptionist's voice output
# Voice ID below = "Rachel" (warm professional voice, pre-built)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ── Security ───────────────────────────────────────────────
ADMIN_API_KEY=change-this-before-deploy   # Header: X-Admin-API-Key

# ── Clinic ─────────────────────────────────────────────────
# Populated automatically after running seed_clinic.py
CLINIC_ID=

# ── Slot Management ────────────────────────────────────────
SLOT_GENERATION_DAYS=30       # How many days ahead to pre-generate slots
SLOT_HOLD_SECONDS=300         # Seconds a slot is held during booking flow
MIN_RESCHEDULE_HOURS=24       # Minimum hours notice required to reschedule
ADVANCE_BOOKING_DAYS=30       # Maximum advance booking window

# ── CORS ───────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
