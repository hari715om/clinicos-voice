    "input_utterances": [
      "Book me with the dentist",
      "My name is Suresh Panda, 7894561230",
      "Next week Monday",
      "First slot in the morning"
    ],
    "expected_tool_calls": [
      {"tool": "check_availability", "args": {"department": "Dentistry"}},
      {"tool": "book_appointment", "args": {}}
    ],
    "expected_outcome": {
      "action": "booked",
      "department": "Dentistry",
      "booking_confirmed": true
    },
    "tags": ["booking", "ambiguous_date", "department_only"]
  },
  {
    "case_id": "book_004",
    "case_type": "booking",
    "description": "Follow-up appointment (existing patient)",
    "input_utterances": [
      "I need a follow-up with Dr. Madhusmita Sahu",
      "Phone is 9937812345",
      "Friday afternoon"
    ],
    "expected_tool_calls": [
      {"tool": "lookup_patient_appointments", "args": {"phone": "9937812345"}},
      {"tool": "check_availability", "args": {"doctor_name": "Dr. Madhusmita Sahu"}},
      {"tool": "book_appointment", "args": {"appointment_type": "follow_up"}}
    ],
    "expected_outcome": {
      "action": "booked",
      "appointment_type": "follow_up",
      "booking_confirmed": true
    },
    "tags": ["booking", "follow_up", "existing_patient"]
  },
  {
    "case_id": "book_005",
    "case_type": "booking",
    "description": "Book when exact requested slot is unavailable — agent suggests alternatives",
    "input_utterances": [
      "I need to see a physiotherapist tomorrow at 9am",
      "My name is Bikash Nayak, 9438012345",
      "The 10am slot works for me"
    ],
    "expected_tool_calls": [
      {"tool": "check_availability", "args": {"department": "Physiotherapy"}},
      {"tool": "book_appointment", "args": {}}
