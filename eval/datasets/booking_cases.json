"""
Eval harness test cases — Booking scenarios.
Each case drives a specific conversation path the voice agent must handle.
"""
[
  {
    "case_id": "book_001",
    "case_type": "booking",
    "description": "New patient books with department preference only (no doctor preference)",
    "input_utterances": [
      "I'd like to book an appointment",
      "I need to see a neurologist",
      "My name is Rajesh Mohanty",
      "My phone number is 9861234567",
      "Tomorrow please, morning",
      "The first available slot is fine"
    ],
    "expected_tool_calls": [
      {"tool": "get_doctor_list", "args": {"department": "Neurology"}},
      {"tool": "check_availability", "args": {}},
      {"tool": "book_appointment", "args": {"appointment_type": "new_consultation"}}
    ],
    "expected_outcome": {
      "action": "booked",
      "booking_confirmed": true,
      "appointment_type": "new_consultation"
    },
    "tags": ["booking", "department_only", "no_doctor_preference", "happy_path"]
  },
  {
    "case_id": "book_002",
    "case_type": "booking",
    "description": "Patient books with specific doctor preference",
    "input_utterances": [
      "I want to book with Dr. Amitav Rath",
      "I'm Priya Dash, phone 8763456789",
      "Any slot this week",
      "Wednesday works for me"
    ],
    "expected_tool_calls": [
      {"tool": "check_availability", "args": {"doctor_name": "Dr. Amitav Rath"}},
      {"tool": "book_appointment", "args": {}}
    ],
    "expected_outcome": {
      "action": "booked",
      "doctor": "Dr. Amitav Rath",
      "booking_confirmed": true
    },
    "tags": ["booking", "specific_doctor", "happy_path"]
  },
  {
    "case_id": "book_003",
